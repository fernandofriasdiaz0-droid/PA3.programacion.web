{
  "name": "medisys-backend",
  "version": "3.0.0",
  "description": "Backend API REST con Express, MongoDB, Bcrypt y JWT para Gestión de Citas Médicas (Medisys PA3)",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "ts-node src/server.ts",
    "seed": "ts-node src/seeds/seedData.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "typescript",
    "jwt",
    "bcrypt",
    "rest-api"
