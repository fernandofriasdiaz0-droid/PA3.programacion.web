# Configuración del servidor Backend Medisys (PA3)
PORT=3000
NODE_ENV=development

# Conexión a MongoDB (Local o MongoDB Atlas)
# Para MongoDB Local: mongodb://127.0.0.1:27017/medisys_db
# Para MongoDB Atlas: mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/medisys_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/medisys_db

# Seguridad y Autenticación JWT (T07)
# Reemplazar por una clave secreta segura en producción
JWT_SECRET=reemplazar_por_clave_secreta_segura_jwt
JWT_EXPIRES_IN=8h

# Orígenes permitidos para clientes Frontend (Angular y React)
CORS_ORIGIN_ANGULAR=http://localhost:4200
CORS_ORIGIN_REACT=http://localhost:5173
