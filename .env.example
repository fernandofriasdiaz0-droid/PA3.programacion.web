# Configuración Global del Proyecto Medisys (PA3)
# Copia este archivo a backend/.env antes de desplegar en producción

PORT=3000
NODE_ENV=development

# URI de conexión a MongoDB (Local o MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/medisys_db

# Seguridad y Autenticación JWT (T07)
JWT_SECRET=reemplazar_por_clave_secreta_segura_jwt
JWT_EXPIRES_IN=8h

# Clientes Frontend conectados al Backend REST
CORS_ORIGIN_ANGULAR=http://localhost:4200
CORS_ORIGIN_REACT=http://localhost:5173

